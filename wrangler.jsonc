{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thanaweya",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thanaweya-db"
    }
  ]
}
